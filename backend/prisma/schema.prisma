// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id         String   @id @default(uuid())
  nom        String
  prenom     String
  email      String   @unique
  password   String
  role       Role     @default(OPERATEUR)
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  imports    ImportExcel[]

  @@map("utilisateurs")
}

model Engin {
  id             String   @id @default(uuid())
  code           String   @unique
  nom            String
  type           String
  categorie      String?
  site           String?
  description    String?
  actif          Boolean  @default(true)
  dernierCompteur Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consommations  Consommation[]

  @@map("engins")
}

model Consommation {
  id                String   @id @default(uuid())
  enginId           String
  engin             Engin    @relation(fields: [enginId], references: [id])
  importId          String?
  import            ImportExcel? @relation(fields: [importId], references: [id])

  date              DateTime
  poste             String   // "Poste 1" ou "Poste 2"
  compteurDebut     Float?
  compteurFin       Float?
  quantiteGasoil    Float
  heuresMarche      Float?
  consommationHeure Float?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("consommations")
}

model ImportExcel {
  id              String   @id @default(uuid())
  nomFichier      String
  cheminFichier   String
  utilisateurId   String
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id])

  statut          StatutImport @default(EN_COURS)
  nombreLignes    Int      @default(0)
  nombreEngins    Int      @default(0)
  nombreErreurs   Int      @default(0)
  erreurs         Json?
  dateImport      DateTime @default(now())
  periodeDebut    DateTime?
  periodeFin      DateTime?

  consommations   Consommation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("imports_excel")
}

enum Role {
  ADMIN
  MANAGER
  OPERATEUR
}

enum StatutImport {
  EN_COURS
  SUCCES
  ERREUR
  PARTIEL
}
